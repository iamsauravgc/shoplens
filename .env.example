# Backend — copy this file to .env at the repo root.
# Every variable is optional; defaults shown are what the app uses out of the box.

# LLM insight-report step. Without it the report step is skipped and
# everything else (tracking, zones, heatmaps, anomalies) still runs.
GROQ_API_KEY=your-groq-key
# Optional: swap provider/model without code changes (any OpenAI-compatible endpoint)
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=openai/gpt-oss-120b

# CORS origin for the Vite dev server
FRONTEND_ORIGIN=http://localhost:5173

# Override storage locations if needed (defaults: <repo>/data/shoplens.db, <repo>/storage, <repo>/data, <repo>/backend/models)
# DATABASE_PATH=C:\Users\you\Desktop\shoplens\data\shoplens.db
# STORAGE_DIR=C:\Users\you\Desktop\shoplens\storage
# DATA_DIR=C:\Users\you\Desktop\shoplens\data
# MODELS_DIR=C:\Users\you\Desktop\shoplens\backend\models

# Frontend (frontend/.env, optional — /api is the default proxy target)
# VITE_API_URL=/api
